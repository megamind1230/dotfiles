# ── fuzzy alias picker ──────────────────────────────────────────────────────
# @desc Fzf picker for bash aliases
fuzzy_alias() {
    local selection name cmd
    selection=$(alias -p \
        | sed 's/^alias //' \
        | awk -F= '{
            name=$1
            cmd=substr($0, index($0,"=")+1)
            gsub(/^["'\'' ]+|["'\'' ]+$/, "", cmd)
            printf "%-15s  %s\n", name, cmd
        }' \
        | fzf --prompt="Alias> " --height=~60% --layout=reverse --border)
    [[ -z "$selection" ]] && return
    name="${selection%%  *}"
    cmd=$(alias "$name" 2>/dev/null | sed "s/^alias ${name}=//; s/^['\"]//; s/['\"]$//")
    READLINE_LINE="$name"
    READLINE_POINT=${#name}
}
bind -x '"\eA":fuzzy_alias'

# ── fuzzy function picker ──────────────────────────────────────────────────
# @desc Fzf picker for bash functions
fuzzy_function() {
    local file selection name
    file=~/.bashrc-functions
    selection=$(
        awk '
            /^# @desc / { desc = substr($0, 8); next }
            /^[a-zA-Z_][a-zA-Z0-9_]*\(\)/ || /^[a-zA-Z_][a-zA-Z0-9_]* *\(\)/ || /^function [a-zA-Z_][a-zA-Z0-9_]*\(\)/ {
                name = $0
                sub(/function /, "", name)
                sub(/\().*/, "", name)
                gsub(/[ \t]/, "", name)
                if (desc != "") printf "%-20s  %s\n", name, desc
                desc = ""
            }
            { if (!/^#/ && !/^[ \t]*$/) desc = "" }
        ' "$file" \
        | fzf --prompt="Fn> " --height=~60% --layout=reverse --border)
    [[ -z "$selection" ]] && return
    name="${selection%%  *}"
    READLINE_LINE="$name"
    READLINE_POINT=${#name}
}
bind -x '"\eF":fuzzy_function'

