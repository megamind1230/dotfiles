# naming convention: website( cf=codeforces /lt=leetcode ) + language(cs,c,cpp,py,go,rs) + IDE( n=nvim(LazyVim), e=emacs, h=helix, v=vscode, z=zed )
# core: cps <website> <language> <ide> ; wrappers generated below
# @desc Show competitive programming setup help
cps_help() {
    cat <<'EOF'
cps - competitive programming setup

USAGE
  cps <website> <language> <ide>
  cps --help | -h

  Generated wrappers: <website><language><ide>
  e.g. cfcsh (codeforces csharp helix), ltpyv (leetcode python vscode)

WEBSITES
  cf   codeforces   (prompts for problem link)
  lt   leetcode     (prompts for problem number)

LANGUAGES
  cs   csharp
  c    c
  cpp  c++
  py   python
  go   go
  rs   rust

IDES
  n   nvim (LazyVim)
  e   emacs
  h   helix
  v   vscode
  z   zed

EXAMPLES
  cfcsh       # codeforces + csharp + helix
  ltpyn       # leetcode + python + nvim (journal)
  cfgoe       # codeforces + go + emacs
  cps --help  # show this help
EOF
}

# @desc Competitive programming project setup
cps() {
    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        cps_help
        return 0
    fi

    local website="$1" lang="$2" ide="$3"

    local template_dir mainfile
    case "$lang" in
        cs)  template_dir="csharp-template"; mainfile="Program.cs" ;;
        c)   template_dir="c-template";      mainfile="main.c" ;;
        cpp) template_dir="cpp-template";    mainfile="main.cpp" ;;
        py)  template_dir="python-template"; mainfile="main.py" ;;
        go)  template_dir="go-template";     mainfile="main.go" ;;
        rs)  template_dir="rust-template";   mainfile="main.rs" ;;
        *)   echo "unknown language: $lang" >&2; return 1 ;;
    esac

    local id site_name
    if [[ "$website" == "cf" ]]; then
        local url path
        read -p "Problem link: " url
        url="${url%%\?*}"                 # strip query string (?locale=...)
        url="${url%/}"                    # strip trailing slash
        path="${url#*codeforces.com/}"    # keep full path after domain
        id="${path//\//-}"                # slashes -> dashes
        site_name="codeforces-$id-$website$lang$ide"
    else
        read -p "Problem number: " id
        site_name="leetcode-$id-$website$lang$ide"
    fi

    local dir="$HOME/cp/$site_name"
    rm -rf "$dir"
    cp -r "$HOME/cp/templates/$template_dir" "$dir"
    if [[ "$lang" == "cs" ]]; then
        mv "$dir/template.csproj" "$dir/$site_name.csproj"
    fi

    case "$ide" in
        n) NVIM_APPNAME=LazyVim nvim --cmd "cd $dir" -c "lua require('competition').open('$dir','$mainfile')" ;;
        e) ~/scripts/emacs-app baka -n --eval "(dt/cp-open \"$dir\" \"$mainfile\")" ;;
        h) helix -w "$dir" "$dir/$mainfile" ;;
        v) code "$dir" ;;
        z) zed -n "$dir" & ;;
        *) echo "unknown ide: $ide" >&2; return 1 ;;
    esac
}

for __site in cf lt; do
    for __lang in cs c cpp py go rs; do
        for __ide in n e h v z; do
            eval "${__site}${__lang}${__ide}() { cps $__site $__lang $__ide; }"
        done
    done
done
unset __site __lang __ide

